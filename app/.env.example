# Copia este archivo a .env.local y completa los valores reales.
#
# En el CLIENTE (Vite en el navegador) solo va la clave PÚBLICA
# (publishable / anon). Todo lo que empiece por VITE_ acaba en el bundle
# que descarga el navegador, así que es visible para cualquiera.
#
# NUNCA pongas aquí la SECRET KEY ni el service_role: saltan el RLS y dan
# acceso total a la base de datos. Esas claves viven en el servidor.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
