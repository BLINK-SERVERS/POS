{
  "name": "blink-pos-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "BLINK POS — Punto de venta (aplicación propia, diseño y código originales).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/POS/ && node scripts/postbuild-pages.mjs",
    "deploy": "npm run build:pages && gh-pages -d dist -t",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
