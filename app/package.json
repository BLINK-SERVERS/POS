{
  "name": "blink-pos-app",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "description": "BLINK POS — Punto de venta (aplicación propia, diseño y código originales).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/postbuild-pages.mjs",
    "deploy": "npm run build:pages && gh-pages -d dist -t",
    "preview": "vite preview",
    "test": "vitest run",
    "test:migrations": "node scripts/test-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og-image.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "gh-pages": "^6.3.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
